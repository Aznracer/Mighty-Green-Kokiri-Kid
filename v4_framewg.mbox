From c24ac8c3f802284f80e08c3374bff345d117120f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 16 Nov 2026 19:40:45 -0500
Subject: [PATCH] Frame workgroup (DM_FRAME_WG) from v3

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Claude-Session: https://claude.ai/code/session_01WGrCTWig49u9S8ZCH37TUc
---
 dm/gfx/nvn/hle_nvn.c | 40 +++++++++++++++++++++++++++++++++++++++-
 dm/gfx/nvn/nvn_rec.h |  1 +
 dm/host/hle_thread.c |  2 ++
 3 files changed, 42 insertions(+), 1 deletion(-)

diff --git a/dm/gfx/nvn/hle_nvn.c b/dm/gfx/nvn/hle_nvn.c
index 2eda410e..ec531d2f 100644
--- a/dm/gfx/nvn/hle_nvn.c
+++ b/dm/gfx/nvn/hle_nvn.c
@@ -38,6 +38,8 @@
 #include <sys/resource.h>
 #include <sys/sysctl.h>
 #include <mach/thread_policy.h>
+#include <os/workgroup.h>
+#include <dlfcn.h>
 #include <assert.h>
 #include <stdatomic.h>
 #include <mach-o/getsect.h>
@@ -1160,6 +1162,7 @@ static uint8_t *cmd_alloc(cmd_t *o, uint32_t size) {
 // 8-byte BEGIN on each of several hundred recordings a model came out a 4 KB page over its resource size table entry
 NVN(nvnCommandBufferBeginRecording, void, NVNcommandBuffer *c) {
     cmd_t *o = CB(c);
+    { void dm_frame_wg_join(void); dm_frame_wg_join(); }   // a thread that records command buffers works to the frame's deadline (once per thread)
     if (o->recording) LOG("[RED] BeginRecording re-entered");
     o->recording = 2;   // 2: recording, no command yet (cmd_alloc sets begin)
     o->rec_id = atomic_fetch_add_explicit(&g_rec_serial, 1, memory_order_relaxed) + 1;
@@ -1947,6 +1950,41 @@ static _Atomic uint64_t g_screen_at;   // when the screen wait released the acqu
 uint64_t dm_nvn_frame_count(void) { return g_frame; }
 extern uint64_t g_t0_ns;   // Host process start point (main.c; same base as the UIMSG timestamps)
 uint64_t mtl_present_screen_wait(double period);   // nvn_mtl.m
+// Frame workgroup (DM_FRAME_WG, on by default; 0 off; ported from the v3 branch): the threads that make a frame (the acquiring thread, the encode thread, the threads that
+// record command buffers) join one os_workgroup interval, and the acquiring thread marks each frame as an interval with the present period as its deadline. That is how the
+// system's performance controller learns that these threads work to a deadline together: without it Ocarina of Time in Kakariko ran 5-15% of its CPU time on performance
+// cores (iPhone Duo, frames of 30-36 ms with the GPU at 13-15 ms), 55-65% with it on v3. Interval workgroups are made by AudioWorkIntervalCreate (AudioToolbox, looked up at run
+// time), the documented way for an app's own real-time threads with a cadence of their own
+static os_workgroup_interval_t g_fwg; static int g_fwg_state;   // 0 not tried, 1 made, -1 off or failed
+static __thread int t_fwg_joined; static __thread os_workgroup_join_token_s t_fwg_tok;
+static uint64_t g_fwg_joins, g_fwg_fail;
+static int fwg_get(void) {
+    if (g_fwg_state) return g_fwg_state > 0;
+    const char *e = getenv("DM_FRAME_WG"); if (e && !strcmp(e, "0")) { g_fwg_state = -1; LOG("[nvn] DM_FRAME_WG=0: no frame workgroup"); return 0; }
+    void *h = dlopen("/System/Library/Frameworks/AudioToolbox.framework/AudioToolbox", RTLD_LAZY);
+    os_workgroup_interval_t (*mk)(const char *, os_clockid_t, os_workgroup_attr_t) = h ? (os_workgroup_interval_t (*)(const char *, os_clockid_t, os_workgroup_attr_t))dlsym(h, "AudioWorkIntervalCreate") : NULL;
+    g_fwg = mk ? mk("nxnative frame", OS_CLOCK_MACH_ABSOLUTE_TIME, NULL) : NULL;
+    g_fwg_state = g_fwg ? 1 : -1;
+    LOG("[nvn] frame workgroup: %s", g_fwg ? "made (the frame's threads join it; each frame is an interval with the present period as deadline)" : "[RED] AudioWorkIntervalCreate unavailable, none");
+    return g_fwg_state > 0;
+}
+void dm_frame_wg_join(void) {   // the calling thread works to the frame's deadline (nvn_rec.h's encode thread, the recording threads, the acquiring thread)
+    if (t_fwg_joined || !fwg_get()) return;
+    int r = os_workgroup_join(g_fwg, &t_fwg_tok);
+    t_fwg_joined = r ? -1 : 1;
+    if (r) { if (!g_fwg_fail++) { char nm[64] = ""; pthread_getname_np(pthread_self(), nm, sizeof nm); LOG("[nvn] frame workgroup: [RED] thread '%s' could not join (errno %d)", nm, r); } }
+    else { char nm[64] = ""; pthread_getname_np(pthread_self(), nm, sizeof nm); if (g_fwg_joins++ < 12) LOG("[nvn] frame workgroup: thread '%s' joined", nm); }
+}
+void dm_frame_wg_leave(void) { if (t_fwg_joined == 1) { os_workgroup_leave(g_fwg, &t_fwg_tok); t_fwg_joined = 0; } }   // hle_thread.c thread_exit (no logging: a guest stack may be small)
+static void fwg_frame(uint64_t period_ns) {   // on the acquiring thread, once per frame: the previous interval ends, the next one starts now with its deadline one period away
+    if (!period_ns || !fwg_get()) return;
+    dm_frame_wg_join(); if (t_fwg_joined < 0) return;
+    static int started; static mach_timebase_info_data_t tb; if (!tb.denom) mach_timebase_info(&tb);
+    if (started) (void)os_workgroup_interval_finish(g_fwg, NULL);
+    uint64_t now = mach_absolute_time(), dl = now + period_ns * tb.denom / tb.numer;
+    int r = os_workgroup_interval_start(g_fwg, now, dl, NULL); started = !r;
+    static int said; if (r && !said++) LOG("[nvn] frame workgroup: [RED] interval start failed (errno %d)", r);
+}
 NVN(nvnWindowAcquireTexture, NVNwindowAcquireTextureResult, NVNwindow *w, NVNsync *s, int *idx) {
     win_t *o = (win_t *)w;
     int n = window_active(o);
@@ -1954,7 +1992,7 @@ NVN(nvnWindowAcquireTexture, NVNwindowAcquireTextureResult, NVNwindow *w, NVNsyn
     // Vsync blocks here (real-device NVN: when all textures in the swapchain are waiting for display, wait for the next one to be released), not in present -- the game often calls present while holding a lock
     uint64_t at = *idx < 4 ? o->avail[*idx] : 0, now = dm_detclock_enabled() ? guest_ns() : now_ns(), wait = at > now ? at - now : 0, pace_ns = 0, drain_ns = 0;
     if (!dm_detclock_enabled()) {   // Register the acquire thread as a time-constraint thread (no longer registered only when it "arrived early": it must also declare itself when it is constantly behind in the hot state)
-        uint64_t period = present_period(o); rt_acquire(rt_period_ns(o, period));
+        uint64_t period = present_period(o), rtp = rt_period_ns(o, period); rt_acquire(rtp); fwg_frame(rtp);
         uint64_t p0 = now_ns(); int snap = mtl_snap_on();
         o->follow = 1;   // the beat paces this frame only where the branches below wait for the slot time (nvn_pace_follow)
         if (present_unpaced(o)) {}   // present interval 0: no vsync wait (below); only the free texture the ticket wait below gives
diff --git a/dm/gfx/nvn/nvn_rec.h b/dm/gfx/nvn/nvn_rec.h
index 47ed4e59..38d2b9fa 100644
--- a/dm/gfx/nvn/nvn_rec.h
+++ b/dm/gfx/nvn/nvn_rec.h
@@ -315,6 +315,7 @@ static void rec_exec(const rec_t *r) {
 static void *rec_thread(void *arg) {
     (void)arg; pthread_setname_np("dm-encode");
     pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+    { void dm_frame_wg_join(void); dm_frame_wg_join(); }   // hle_nvn.c: the encode thread works to the frame's deadline
     void *rt = nvn_rt_join("encode thread");   // it makes the frame's Metal calls: it declares the frame's deadline too (hle_nvn.c rt_tick)
     for (;;) {
         pthread_mutex_lock(&g_rb_mu);
diff --git a/dm/host/hle_thread.c b/dm/host/hle_thread.c
index 264bae4b..4683298c 100644
--- a/dm/host/hle_thread.c
+++ b/dm/host/hle_thread.c
@@ -414,7 +414,9 @@ static void thr_put(thr_t *t) {   // Holding G; drop a reference taken with t->r
     if (!--t->refs && t->closed && t->exited) thr_free(t);
 }
 static void wake_sync_waiters(const void *obj);
+__attribute__((weak)) void dm_frame_wg_leave(void) {}   // hle_nvn.c: a thread that joined the frame workgroup leaves it (one still joined when it exits is a crash in libdispatch)
 static void thread_exit(thr_t *t) {
+    dm_frame_wg_leave();
     t->exit_ns = now_ns(); t->exit_tick = dm_thread_tick_fn ? dm_thread_tick_fn() : 0;
     // No logging here: the exit happens on the guest thread's own stack (some are only a dozen or so KiB), and a printf with floating point would blow the stack (real-device smoke test: SIGBUS when LibcurlResolver exits, backtrace fprintf → __dtoa). Only the time is recorded, and it is printed later in the state dump
     g_lock();
-- 
