@@ -7,15 +7,30 @@
 #pragma once
 #import <GameController/GameController.h>
 #include <stdint.h>
+#include <stdlib.h>
+#include <strings.h>
 #include "dm_input.h"
 
 static inline int dm_pad_labelled(GCController *c) {
     NSString *k = c.productCategory;
     return [k isEqualToString:@"Switch Pro Controller"] || [k containsString:@"Joy-Con"];
 }
+// DM_PAD_LAYOUT=xbox / playstation (dm_input.h): the face buttons follow the labels printed on an Xbox or PlayStation pad (A bottom, B right, X left, Y top /
+// Cross bottom, Circle right, Square left, Triangle top) instead of the Switch's positions (right A, bottom B, top X, left Y). Nintendo pads always map by their labels.
 // DM_BTN_A / B / X / Y of the pad's pressed face buttons
 static inline uint64_t dm_pad_face(GCExtendedGamepad *g) {
     GCControllerButtonInput *a = g.buttonA, *b = g.buttonB, *x = g.buttonX, *y = g.buttonY;
-    if (!dm_pad_labelled(g.controller)) { GCControllerButtonInput *t = a; a = b; b = t; t = x; x = y; y = t; }   // by position: right A, bottom B, top X, left Y
+    if (!dm_pad_labelled(g.controller) && !dm_pad_labels_mode()) { GCControllerButtonInput *t = a; a = b; b = t; t = x; x = y; y = t; }   // by position: right A, bottom B, top X, left Y
     return (a.isPressed ? DM_BTN_A : 0) | (b.isPressed ? DM_BTN_B : 0) | (x.isPressed ? DM_BTN_X : 0) | (y.isPressed ? DM_BTN_Y : 0);
 }
+
+// All NpadButton bits of an extended gamepad (face + shoulders, triggers, menu/options, stick clicks, dpad), with DM_PAD_LAYOUT and DM_PAD_MAP applied.
+static inline uint64_t dm_pad_buttons(GCExtendedGamepad *g) {
+    uint64_t m = dm_pad_face(g);
+    #define K(btn, bit) if (btn.isPressed) m |= (bit)
+    K(g.leftShoulder, DM_BTN_L); K(g.rightShoulder, DM_BTN_R); K(g.leftTrigger, DM_BTN_ZL); K(g.rightTrigger, DM_BTN_ZR);
+    K(g.buttonMenu, DM_BTN_PLUS); K(g.buttonOptions, DM_BTN_MINUS); K(g.leftThumbstickButton, DM_BTN_LS); K(g.rightThumbstickButton, DM_BTN_RS);   // nil on pads without them: not pressed
+    K(g.dpad.left, DM_BTN_LEFT); K(g.dpad.up, DM_BTN_UP); K(g.dpad.right, DM_BTN_RIGHT); K(g.dpad.down, DM_BTN_DOWN);
+    #undef K
+    return dm_pad_remap(m);
+}
