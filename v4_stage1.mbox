+static ImgBuf end_guide_1555(CGContextRef ctx, uint8_t *b) {
+    for (size_t i = 0; i < 1555 * 1511; i++) {
+        uint8_t a = b[i * 4 + 3];
+        b[i * 4] = b[i * 4 + 1] = b[i * 4 + 2] = 255;
+        b[i * 4 + 3] = a;
+    }
+    CGContextRelease(ctx);
+    return img_alloc(1555, 1511, b);
+}
